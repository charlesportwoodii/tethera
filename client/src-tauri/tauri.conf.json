{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tethera",
  "version": "0.1.0",
  "identifier": "com.alaydriem.tethera",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "Tethera",
        "width": 420,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["tethera"] },
      "mobile": [{ "scheme": ["tethera"], "appLink": false }]
    }
  },
  "bundle": {
    "android": {
      "minSdkVersion": 30,
      "versionCode": 1000000
    },
    "iOS": {
      "minimumSystemVersion": "26.0",
      "bundleVersion": "1000000",
      "infoPlist": "./Info.ios.plist"
    },
    "macOS": {
      "bundleVersion": "1000000",
      "minimumSystemVersion": "26.0",
      "infoPlist": "./Info.macos.plist",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {}
    },
    "category": "SocialNetworking",
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": [
      "app",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
